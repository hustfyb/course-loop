# Copy into .dev.vars only for local development.
ADMIN_EMAILS=hustfyb@gmail.com
LOCAL_DEV=1
DEV_EMAIL_CODE=482916
# Production: ADMIN_EMAILS only. Never enable LOCAL_DEV or DEV_EMAIL_CODE.

# 自托管（npm run serve）进程内直发邮件用；不配置则邮件功能离线。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=teacher@example.com
# SMTP_PASS=填写 SMTP 授权码，仅保存在本机
# SMTP_FROM=课序 <teacher@example.com>
# 可选：显式指定 pi 路径，跳过 PATH 自动扫描。
# PI_COMMAND=C:\path\to\pi.cmd
# 可选：追加到所有 pi 调用的参数，如锁定模型。
# PI_ARGS=--provider carbit --model qwen38-nvfp4
